        "class": "post-bungalow-highlight",
        "headings": [
          "The four inviting units of the South Garden Bungalows are a new generation of bungalows with traditional roofs and sleek interiors—a descriptive intersection between vintage and modern.",
          "The four inviting units of the South Garden Bungalows are a new generation of bungalows with traditional roofs and sleek interiors—a descriptive intersection between vintage and modern."
        ],
        "images": [
          {
            "alt": "2 Adults",
            "src": "https://vold-independent.s3.ap-southeast-1.amazonaws.com/icons/9142e06f-34c7-41a3-9d31-efa446353efa/raw/vectorpng.png"
