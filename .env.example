SITE_ID=sodai-standard
CONTENT_ENV=local
TEMPLATE_VARIANT=standard
# Public pages always read the site-scoped database publication. No fixture fallback.
# Legacy CONTENT_MODE is retained for compatibility; use live.
CONTENT_MODE=live
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_SESSION_VERSION=1
OWNER_IDENTIFIER=
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=
SUPER_ADMIN_IDENTIFIER=
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_TOTP_SECRET=
# ADMIN_TOTP=off allows password-only sign-in; TOTP secrets are then ignored.
# Optional local/operator connection to the selected NETLIFY-managed branch.
DATABASE_URL=
# On Netlify set VILLA_ID (Netlify's SITE_ID is its own UUID) and CONTENT_ENV;
# seed with the same VILLA_ID, CONTENT_ENV and CONTEXT=production.
# Netlify supplies CONTEXT, DEPLOY_ID, NETLIFY and Blobs runtime context.
# Deployed contexts require CONTENT_ENV; non-production deploys require DEPLOY_ID.
# Never use NEXT_PUBLIC_ for secrets. Escape each hash $ as \$ in .env.local.

# Local offline demo: prefer npm run demo:local; do not enable these on Netlify.
# The runner supplies a loopback DB/origin, isolated SITE_ID/CONTENT_ENV and hash/secret.
# LOCAL_DEMO=1
# LOCAL_DEMO_RUNNER=loopback-v1
# MEDIA_PROVIDER=filesystem
# LOCAL_DEMO_DATA_DIR=<project>/local-data/signature
# LOCAL_DEMO_PASSWORD_HASH=<runner-generated bcrypt12 hash; server-only>
# Optional runner controls (not hosted configuration):
# LOCAL_DEMO_PORT=3112
# LOCAL_DEMO_DATASET=isolated-review-name
